meeting.genomicschain.io {
	# Static landing page for browser visitors
	handle / {
		root * /srv/static
		file_server
	}

	# Frozen verification address for anchored deposits (ANC-7). The public URL
	# /anchor/<slug> is baked into immutable Zenodo documents, so it must resolve
	# durably: rewrite to the app's ANC-7 public view under /place/web/anchor/<slug>.
	handle /anchor/* {
		rewrite * /place/web{uri}
		# Overwrite any client-supplied X-Real-IP with the real connection peer so
		# the app's IP-based public rate limiter keys on the true client, not a
		# spoofable header or the shared proxy IP.
		reverse_proxy meeting-place:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	# API routes to KairosChain app
	# request_body caps the pre-parse body size (app-level deposit cap is ~100KB;
	# 256KB leaves headroom for metadata/envelope while rejecting oversized bodies with 413).
	handle /place/* {
		request_body {
			max_size 256KB
		}
		# header_up X-Real-IP {remote_host}: the anonymous /place/web/* surface
		# (skill catalog, SkillSet catalog, ANC-7 verify) rate-limits per client
		# IP; {remote_host} overwrites any forged X-Real-IP and avoids collapsing
		# all clients into the single Caddy container IP.
		reverse_proxy meeting-place:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /meeting/* {
		request_body {
			max_size 256KB
		}
		reverse_proxy meeting-place:8080 {
			header_up X-Real-IP {remote_host}
		}
	}
	handle /health {
		reverse_proxy meeting-place:8080
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
