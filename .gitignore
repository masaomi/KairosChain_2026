docker/.env

# Runtime data directory (created by `kairos_mcp_server init`)
.kairos/

# MCP server config (environment-specific)
.mcp.json
__pycache__/

# Work-in-progress drafts. Already-tracked files under this path keep working
# normally; only new files are hidden. Commit a deliverable explicitly with
# `git add -f`, and check what is being hidden with
# `git status --ignored --short docs/drafts/`.
docs/drafts/*

# Minimum Nomic games. The harness under bench/minimum_nomic/ is tracked; the
# games it produces never are. The corpus lives under log/ (already ignored);
# these two lines catch output written next to the harness by mistake.
bench/minimum_nomic/**/records/
bench/minimum_nomic/out/

# Generated outputs (ruling 2026-08-27): docs/reports/ holds rendered HTML
# reports; presentations/ holds decks and their rendered files. Two files in
# presentations/ look hand-authored (deck_to_pptx.py,
# omakase-auto-analysis-design.md) — re-track via a `!` exception if wanted.
docs/reports/
presentations/
