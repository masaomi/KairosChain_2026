{
  "name": "agent",
  "version": "1.0.1",
  "description": "Long autonomous runs in the operator's own host session (Claude Code): design → design review → implement → implementation review → layered-deck report, with as few questions as possible. A stand-in (isolated claude -p, Opus 5.5) answers decision points from the operator's own words and the instruction mode; a guard (host hooks) lets through only what the run created or its worktree and branch hold, and queues everything else — governing material, shared files, anything that discloses, publishes, sends or commits the operator — as operator items. Every run ends with a report. Needs an adopted policy (the operator's mandate). Not for unattended operation.",
  "author": "Masaomi Hatakeyama",
  "layer": "L1",
  "depends_on": [
    {
      "name": "llm_client",
      "version": ">= 0.3.0"
    },
    "multi_llm_review"
  ],
  "provides": [
    "agent_runs",
    "stand_in",
    "run_guard"
  ],
  "tool_classes": [
    "KairosMcp::SkillSets::Agent::Tools::AgentStart",
    "KairosMcp::SkillSets::Agent::Tools::AgentStatus",
    "KairosMcp::SkillSets::Agent::Tools::AgentAdvance",
    "KairosMcp::SkillSets::Agent::Tools::AgentItems",
    "KairosMcp::SkillSets::Agent::Tools::AgentFinish",
    "KairosMcp::SkillSets::Agent::Tools::AgentStop"
  ],
  "config_files": [
    "config/policies/default_2026_10_20.rb"
  ],
  "knowledge_dirs": [],
  "min_core_version": "3.94.0",
  "plugin": {
    "skill_md": "plugin/SKILL.md",
    "hooks": "plugin/hooks.json"
  },
