#!/usr/bin/env ruby
# frozen_string_literal: true

# Harness-side entry point for the readable-output gate.
#
# Usage (as a Claude Code Stop hook, produced by mode_hooks_project):
#   kairos-readable-gate --config <path/to/gate_config.json>
#
# Why this shim exists rather than the hook naming the interpreter directly:
#
#   1. PluginProjector only projects hook commands matching /\Akairos-/ without
#      warning. A raw `python3 ...` command warns on every projection, and a
#      warning nobody can act on trains operators to ignore warnings.
#   2. The interpreter is discovered here instead of being frozen into the
#      compiled artifact, so an instance without /usr/bin/python3 still runs.
#   3. The gate script's location differs between an installed SkillSet and the
#      gem's own templates. Resolving it here keeps that off the artifact, which
#      must stay a pure function of (mode identity, declaration).
#
# stdin, stdout and the exit status are passed through untouched: this shim
# must never turn a gate verdict into something else. If the gate cannot be
# found or cannot be run, the shim exits 0 and emits nothing — a broken gate
# must not wedge a session.

require 'json'

SCRIPT_REL = File.join('skillsets', 'kairos_hook_projector', 'hooks', 'readable_gate.py')

def candidate_scripts
  paths = []
  paths << ENV['KAIROS_READABLE_GATE_SCRIPT'] if ENV['KAIROS_READABLE_GATE_SCRIPT']

  # Installed SkillSet, under the instance data dir.
  data_dir = ENV['KAIROS_DATA_DIR']
  data_dir ||= File.join(Dir.pwd, '.kairos')
  paths << File.join(data_dir, SCRIPT_REL)

  # The gem's own templates, for an instance that has not acquired the SkillSet.
  gem_root = File.expand_path('..', __dir__)
  paths << File.join(gem_root, 'templates', SCRIPT_REL)

  paths
end

def resolve_script
  candidate_scripts.find { |p| p && File.file?(p) }
end

def resolve_python
  # PATH first so a pyenv / conda / homebrew interpreter is honoured; the
  # macOS system interpreter is the fallback, not the assumption.
  from_env = ENV['KAIROS_PYTHON']
  return from_env if from_env && File.executable?(from_env)

  ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).each do |dir|
    %w[python3 python].each do |name|
      candidate = File.join(dir, name)
      return candidate if File.executable?(candidate) && !File.directory?(candidate)
    end
  end
  '/usr/bin/python3' if File.executable?('/usr/bin/python3')
end

script = resolve_script
python = resolve_python

# Fail open, loudly enough to diagnose but never blocking.
if script.nil? || python.nil?
  warn "[kairos-readable-gate] not run: " \
       "#{script.nil? ? 'gate script not found' : 'no python interpreter found'}"
  exit 0
end

exec([python, python], script, *ARGV)
